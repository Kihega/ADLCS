{
  "expo": {
    "name": "TzCRVS",
    "slug": "tzcrvs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D4ED8"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D4ED8"
      },
      "package": "tz.go.nbs.census.model",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tz.go.nbs.census.model",
      "infoPlist": {
        "NSCameraUsageDescription": "TzCRVS needs camera access so officers can attach a citizen photo to a record.",
        "NSPhotoLibraryUsageDescription": "TzCRVS needs photo library access so officers can select a citizen photo."
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "cameraPermission": "TzCRVS needs camera access so officers can attach a citizen photo to a record.",
          "photosPermission": "TzCRVS needs photo library access so officers can select a citizen photo."
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "72d43c4b-0583-4e20-a9d3-dcfdd1509d43"
      }
    },
    "owner": "kihega"
  }
}
